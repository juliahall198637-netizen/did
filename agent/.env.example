# LiveKit project (LiveKit Cloud sets these automatically for hosted agents)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-text, AI reply and text-to-speech
OPENAI_API_KEY=

# D-ID avatar (Basic auth key from the D-ID studio)
DID_API_KEY=

# Optional fallbacks; the admin panel values arrive with each session
# DID_AGENT_ID=
# OPENAI_LLM_MODEL=gpt-4.1-mini
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# MAX_SESSION_MINUTES=10
